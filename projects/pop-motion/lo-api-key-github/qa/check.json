        "dataAttributes": {},
        "sourceFile": "/Volumes/LeNguyen02SSD/Programming/agent-vid/projects/pop-motion/lo-api-key-github/index.html",
        "bbox": {
          "x": 0,
          "y": 0,
          "width": 0,
          "height": 0
        },
        "time": 0,
        "fixHint": "Move <section id=\"explainer\"> and its contents into a sub-composition file and mount it with data-composition-src."
      }
