  "review": {
    "brandBlocklist": [],
    "risks": [
      {
        "pattern": "(?<!\\w)(?:số 1|số một|tốt nhất|rẻ nhất|nhanh nhất|đầu tiên trên thế giới|best|cheapest|fastest|number one)(?!\\w)",
        "note": "a superlative: show the source or soften"
      }
    ],
    "checklist": [
      "Every named product, company or feature is a verified fact in data/facts.md (the example map is a generic topic).",
      "The map shows only what the voice says in that scene; no number on screen that the voice does not read."
    ]
