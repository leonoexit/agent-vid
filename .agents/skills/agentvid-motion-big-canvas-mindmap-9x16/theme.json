{
  "skill_name": "agentvid-motion-big-canvas-mindmap-9x16",
  "title": "Big canvas mind map (a pen draws one map, the camera travels, 9:16)",
  "aspect": "portrait-9x16-universal",
  "defaultLanguage": "vi",
  "voices": {
    "en": {
      "engine": "gemini",
      "voice": "Charon",
      "model": "gemini-3.8-flash-tts",
      "style": "clear, friendly teacher explaining at a whiteboard",
      "tempo": 1.0
    },
